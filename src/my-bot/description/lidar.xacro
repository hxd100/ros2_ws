<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <!-- 参数对齐实车 RPLidar A1M8：
           量程 0.15 ~ 12 m，扫描频率 5.5 Hz，360 点/圈（1°），约 8000 点/秒
         挂载点相对 chassis：前 0.1 m，高 0.175 m
         注意：sensor 用 Ignition(gz-sim) 的 gpu_lidar，由 ros_gz_bridge 桥成 /scan；
               不要换成 Gazebo Classic 的 libgazebo_ros_ray_sensor.so。 -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.1 0 0.175" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <!-- RPLidar A1M8 典型 5.5 Hz -->
            <update_rate>5.5</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.141592653589793</min_angle>
                        <max_angle>3.141592653589793</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <!-- A1M8 实测盲区 0.15 m，最大 12 m -->
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
        </sensor>
    </gazebo>
</robot>
